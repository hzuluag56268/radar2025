{
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    
    // === FONT SETTINGS ===
    // Font family - choose a monospace font that's easy to read
    "editor.fontFamily": "'Consolas', 'Courier New', monospace",
    
    // Font size
    "editor.fontSize": 14,
    
    // Line height (1.2 = 20% more space between lines, tighter spacing)
    "editor.lineHeight": 1.2,
    
    // Font weight (600 = semi-bold, makes letters thicker)
    "editor.fontWeight": "500",
    
    // Enable font ligatures (makes operators like =>, ->, == look better)
    "editor.fontLigatures": true,
    
    // === SPACING & LAYOUT ===
    // Letter spacing (0 = normal, positive = more space)
    "editor.letterSpacing": 0.5,
    
    // Tab size
    "editor.tabSize": 4,
    
    // Insert spaces instead of tabs
    "editor.insertSpaces": true,
    
    // Show whitespace characters
    "editor.renderWhitespace": "boundary",
    
    // === VISUAL ENHANCEMENTS ===
    // Bracket pair colorization (colors matching brackets)
    "editor.bracketPairColorization.enabled": true,
    
    // Highlight matching brackets
    "editor.matchBrackets": "always",
    
    // Show line numbers
    "editor.lineNumbers": "on",
    
    // Show minimap (code overview on the right)
    "editor.minimap.enabled": true,
    
    // Word wrap
    "editor.wordWrap": "on",
    
    // === COLOR THEME ===
    // You can change this to any theme you prefer:
    // "Dark+", "Light+", "Monokai", "Solarized Dark", "One Dark Pro", etc.
    "workbench.colorTheme": "Default Dark+",
    
    // === PYTHON SPECIFIC ===
    // Format on save
    "editor.formatOnSave": false,
    
    // Python indentation
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "ms-python.python"
    }
}